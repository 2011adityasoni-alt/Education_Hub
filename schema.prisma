// Education Hub: PostgreSQL schema.
// Conventions
//  - Money is stored as integer paise (never floats).
//  - Financial / academic records use onDelete: Restrict so they never vanish with a parent.
//  - Pure child rows (options, tokens, join rows) use onDelete: Cascade.
//  - Optional ownership links use onDelete: SetNull.
//  - Users are soft-deleted (deletedAt); Restrict on history blocks hard deletes.
//  - Answer keys live ONLY in QuestionKey. API code must never include it in a
//    student-facing select, and constraints.sql restricts DB-level access.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus { ACTIVE SUSPENDED PENDING_VERIFICATION DELETED }
enum OtpChannel { SMS EMAIL }
enum OtpPurpose { LOGIN REGISTER VERIFY_CONTACT }
enum DevicePlatform { ANDROID IOS WEB }

enum CourseLevel { FOUNDATION INTERMEDIATE ADVANCED }
enum CourseStatus { DRAFT IN_REVIEW PUBLISHED ARCHIVED }
enum BatchMode { ONLINE OFFLINE HYBRID }
enum BatchStatus { UPCOMING ONGOING COMPLETED CANCELLED }
enum LessonType { VIDEO LIVE DOCUMENT TEST }
enum VideoProvider { MUX CLOUDFLARE_STREAM }
enum VideoStatus { UPLOADING PROCESSING READY ERRORED }
enum MaterialKind { PDF NOTES DPP OTHER }
enum EnrollmentStatus { ACTIVE EXPIRED REVOKED REFUNDED }

enum LiveProvider { LIVEKIT HUNDRED_MS }
enum LiveStatus { SCHEDULED LIVE ENDED CANCELLED }

enum QuestionType { SINGLE_CHOICE MULTI_CHOICE NUMERICAL }
enum TestStatus { DRAFT SCHEDULED PUBLISHED CLOSED }
enum AttemptStatus { IN_PROGRESS SUBMITTED AUTO_SUBMITTED EVALUATED }

enum PaymentStatus { CREATED AUTHORIZED CAPTURED FAILED REFUNDED PARTIALLY_REFUNDED }
enum RefundStatus { REQUESTED APPROVED PROCESSING PROCESSED REJECTED FAILED }
enum DiscountType { PERCENT FIXED }
enum WebhookStatus { RECEIVED PROCESSED FAILED }

enum DoubtStatus { OPEN ANSWERED RESOLVED CLOSED }
enum ModerationStatus { PENDING APPROVED HIDDEN }
enum NotificationType { CLASS_REMINDER TEST_REMINDER PAYMENT ENROLLMENT DOUBT_REPLY ANNOUNCEMENT BOOKING SUPPORT SYSTEM }
enum AnnouncementAudience { ALL STUDENTS TEACHERS }

enum CentreStatus { PENDING ACTIVE SUSPENDED }
enum BookingStatus { REQUESTED CONFIRMED RESCHEDULED COMPLETED CANCELLED NO_SHOW }
enum TicketStatus { OPEN IN_PROGRESS WAITING_ON_USER RESOLVED CLOSED }
enum TicketPriority { LOW NORMAL HIGH URGENT }

// ─────────────────── Identity, auth, RBAC ───────────────────

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String?    @unique
  phone           String?    @unique // E.164
  passwordHash    String? // optional: OTP-first auth
  fullName        String
  avatarUrl       String?
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  tokenVersion    Int        @default(0) // bump to revoke every access token
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  roles            UserRole[]
  studentProfile   StudentProfile?
  teacherProfile   TeacherProfile?
  adminProfile     AdminProfile?
  otpCodes         OtpCode[]
  refreshTokens    RefreshToken[]
  deviceTokens     DeviceToken[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  requestedTickets SupportTicket[]  @relation("TicketRequester")
  assignedTickets  SupportTicket[]  @relation("TicketAssignee")
  ticketMessages   TicketMessage[]
  doubtReplies     DoubtReply[]
  liveChatMessages LiveChatMessage[]
  requestedRefunds Refund[]         @relation("RefundRequester")
  reviewedRefunds  Refund[]         @relation("RefundReviewer")
  createdCourses   Course[]         @relation("CourseCreator")
  announcements    Announcement[]   @relation("AnnouncementAuthor")

  @@index([status])
  @@index([deletedAt])
}

model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @db.Uuid // null while registering (user not created yet)
  target      String // email or E.164 phone
  channel     OtpChannel
  purpose     OtpPurpose
  codeHash    String // hash only; the raw code is never stored
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  requestIp   String?
  createdAt   DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([target, purpose, createdAt])
  @@index([expiresAt])
  @@index([userId])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid // rotation family; reuse of a revoked token kills the family
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  token      String         @unique // FCM registration token
  platform   DevicePlatform
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // student | teacher | support | admin | super_admin
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // e.g. course:write
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
}

model StudentProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  examTarget  String? // JEE, NEET, Board, ...
  gradeLevel  String?
  city        String?
  state       String?
  language    String    @default("en")
  dateOfBirth DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  liveAttendance LiveAttendance[]
  attempts       TestAttempt[]
  results        TestResult[]
  payments       Payment[]
  couponRedeemed CouponRedemption[]
  doubts         Doubt[]
  reviews        Review[]
  centreReviews  CentreReview[]
  bookings       CounsellingBooking[]
}

model TeacherProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  headline        String?
  bio             String?
  qualifications  String?
  experienceYears Int      @default(0)
  subjects        String[]
  isVerified      Boolean  @default(false)
  ratingAvg       Decimal  @default(0) @db.Decimal(3, 2)
  ratingCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses        CourseTeacher[]
  liveSessions   LiveSession[]
  tests          Test[]
  materials      StudyMaterial[]
  assignedDoubts Doubt[]

  @@index([isVerified])
}

model AdminProfile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  department String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────── Catalog and learning ─────────────────────

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String?  @db.Uuid
  name      String
  slug      String   @unique
  iconUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  courses  Course[]

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model Course {
  id              String       @id @default(uuid()) @db.Uuid
  categoryId      String       @db.Uuid
  createdById     String       @db.Uuid
  title           String
  slug            String       @unique
  subtitle        String?
  description     String?
  thumbnailUrl    String?
  language        String       @default("en")
  level           CourseLevel  @default(FOUNDATION)
  examTarget      String?
  priceInPaise    Int
  mrpInPaise      Int
  status          CourseStatus @default(DRAFT)
  publishedAt     DateTime?
  durationMinutes Int          @default(0) // denormalised, recomputed by the API
  ratingAvg       Decimal      @default(0) @db.Decimal(3, 2)
  ratingCount     Int          @default(0)
  enrollmentCount Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  category      Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy     User                 @relation("CourseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  teachers      CourseTeacher[]
  batches       Batch[]
  lessons       Lesson[]
  materials     StudyMaterial[]
  enrollments   Enrollment[]
  liveSessions  LiveSession[]
  tests         Test[]
  payments      Payment[]
  coupons       Coupon[]
  doubts        Doubt[]
  reviews       Review[]
  bookings      CounsellingBooking[]
  announcements Announcement[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([createdById])
  @@index([deletedAt])
}

model CourseTeacher {
  courseId  String   @db.Uuid
  teacherId String   @db.Uuid
  isLead    Boolean  @default(false)
  createdAt DateTime @default(now())

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@id([courseId, teacherId])
  @@index([teacherId])
}

model Batch {
  id        String      @id @default(uuid()) @db.Uuid
  courseId  String      @db.Uuid
  centreId  String?     @db.Uuid
  name      String
  mode      BatchMode   @default(ONLINE)
  status    BatchStatus @default(UPCOMING)
  startsAt  DateTime
  endsAt    DateTime?
  capacity  Int?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  course       Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  centre       LearningCentre? @relation(fields: [centreId], references: [id], onDelete: SetNull)
  lessons      Lesson[]
  enrollments  Enrollment[]
  liveSessions LiveSession[]
  payments     Payment[]

  @@unique([courseId, name])
  @@index([status, startsAt])
  @@index([centreId])
}

model Lesson {
  id              String     @id @default(uuid()) @db.Uuid
  courseId        String     @db.Uuid
  batchId         String?    @db.Uuid // null = visible to every batch of the course
  sectionTitle    String?
  title           String
  description     String?
  type            LessonType @default(VIDEO)
  position        Int
  isFreePreview   Boolean    @default(false)
  isPublished     Boolean    @default(false)
  durationSeconds Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batch       Batch?           @relation(fields: [batchId], references: [id], onDelete: SetNull)
  video       VideoLecture?
  liveSession LiveSession?
  materials   StudyMaterial[]
  progress    LessonProgress[]
  tests       Test[]
  doubts      Doubt[]

  @@index([courseId, position])
  @@index([batchId])
}

model VideoLecture {
  id                 String        @id @default(uuid()) @db.Uuid
  lessonId           String        @unique @db.Uuid
  provider           VideoProvider
  providerAssetId    String // Mux asset id / Cloudflare video uid
  providerPlaybackId String // used to mint SIGNED playback URLs server-side
  status             VideoStatus   @default(UPLOADING)
  durationSeconds    Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAssetId])
}

model LessonProgress {
  id                  String    @id @default(uuid()) @db.Uuid
  studentId           String    @db.Uuid
  lessonId            String    @db.Uuid
  lastPositionSeconds Int       @default(0)
  watchedSeconds      Int       @default(0)
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([lessonId])
}

model StudyMaterial {
  id            String       @id @default(uuid()) @db.Uuid
  courseId      String       @db.Uuid
  lessonId      String?      @db.Uuid
  uploadedById  String?      @db.Uuid
  title         String
  kind          MaterialKind @default(PDF)
  storageKey    String // object-storage key. NEVER a public URL; served via short-lived signed URLs
  mimeType      String
  sizeBytes     BigInt
  isFreePreview Boolean      @default(false)
  isPublished   Boolean      @default(false)
  downloadCount Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  course     Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson     Lesson?         @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  uploadedBy TeacherProfile? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([courseId, isPublished])
  @@index([lessonId])
}

model Enrollment {
  id         String           @id @default(uuid()) @db.Uuid
  studentId  String           @db.Uuid
  courseId   String           @db.Uuid
  batchId    String?          @db.Uuid
  paymentId  String?          @unique @db.Uuid // set only after a verified webhook
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  expiresAt  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course  Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batch   Batch?         @relation(fields: [batchId], references: [id], onDelete: SetNull)
  payment Payment?       @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId])
  @@index([courseId, status])
  @@index([batchId])
}

// ───────────────────────── Live classes ─────────────────────────

model LiveSession {
  id               String       @id @default(uuid()) @db.Uuid
  courseId         String       @db.Uuid
  batchId          String?      @db.Uuid
  lessonId         String?      @unique @db.Uuid
  teacherId        String       @db.Uuid
  title            String
  description      String?
  scheduledStart   DateTime
  scheduledEnd     DateTime
  actualStart      DateTime?
  actualEnd        DateTime?
  status           LiveStatus   @default(SCHEDULED)
  provider         LiveProvider @default(LIVEKIT)
  providerRoomId   String?      @unique
  chatEnabled      Boolean      @default(true)
  recordingEnabled Boolean      @default(false) // only where legally permitted
  recordingKey     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  course     Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batch      Batch?            @relation(fields: [batchId], references: [id], onDelete: SetNull)
  lesson     Lesson?           @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  teacher    TeacherProfile    @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  attendance LiveAttendance[]
  chat       LiveChatMessage[]

  @@index([status, scheduledStart])
  @@index([courseId, scheduledStart])
  @@index([teacherId, scheduledStart])
}

model LiveAttendance {
  id              String    @id @default(uuid()) @db.Uuid
  sessionId       String    @db.Uuid
  studentId       String    @db.Uuid
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?
  durationSeconds Int       @default(0)

  session LiveSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model LiveChatMessage {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @db.Uuid
  senderId  String    @db.Uuid
  body      String
  deletedAt DateTime? // moderation
  createdAt DateTime  @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender  User        @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([sessionId, createdAt])
}

// ───────────────────── Tests and examinations ─────────────────────

model Test {
  id                 String     @id @default(uuid()) @db.Uuid
  courseId           String?    @db.Uuid
  lessonId           String?    @db.Uuid
  createdById        String?    @db.Uuid
  title              String
  instructions       String?
  durationMinutes    Int
  totalMarks         Decimal    @db.Decimal(8, 2)
  passMarks          Decimal?   @db.Decimal(8, 2)
  maxAttempts        Int        @default(1)
  shuffleQuestions   Boolean    @default(false)
  status             TestStatus @default(DRAFT)
  opensAt            DateTime?
  closesAt           DateTime?
  solutionsReleaseAt DateTime? // explanations stay hidden until then
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  course    Course?         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  lesson    Lesson?         @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdBy TeacherProfile? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sections  TestSection[]
  questions Question[]
  attempts  TestAttempt[]
  results   TestResult[]

  @@index([status, opensAt])
  @@index([courseId])
}

model TestSection {
  id       String  @id @default(uuid()) @db.Uuid
  testId   String  @db.Uuid
  name     String
  subject  String?
  position Int

  test      Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([testId, position])
}

model Question {
  id            String       @id @default(uuid()) @db.Uuid
  testId        String       @db.Uuid
  sectionId     String?      @db.Uuid
  position      Int
  type          QuestionType @default(SINGLE_CHOICE)
  subject       String?
  stem          String
  imageUrl      String?
  marks         Decimal      @default(4) @db.Decimal(5, 2)
  negativeMarks Decimal      @default(1) @db.Decimal(5, 2) // deducted for a wrong answer
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  test    Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  section TestSection?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  options QuestionOption[]
  key     QuestionKey? // SECRET: see below
  answers AttemptAnswer[]

  @@unique([testId, position])
  @@index([sectionId])
}

model QuestionOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @db.Uuid
  position   Int
  label      String
  imageUrl   String?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
}

/// SECRET. Answer key and explanation. Only the grading service and authorised
/// authors (permission test:read_keys) may select this model. Never use `include: { key: true }`
/// on a student-facing query. 1:1 with Question so access can be granted or revoked separately.
model QuestionKey {
  questionId       String   @id @db.Uuid
  correctOptionIds String[] @db.Uuid
  numericAnswer    Decimal? @db.Decimal(18, 6)
  numericTolerance Decimal? @db.Decimal(18, 6)
  explanation      String?
  updatedAt        DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model TestAttempt {
  id          String        @id @default(uuid()) @db.Uuid
  testId      String        @db.Uuid
  studentId   String        @db.Uuid
  attemptNo   Int           @default(1)
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  deadlineAt  DateTime // computed on the SERVER at start; the client timer is cosmetic
  submittedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  test    Test            @relation(fields: [testId], references: [id], onDelete: Restrict)
  student StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  answers AttemptAnswer[]
  result  TestResult?

  @@unique([testId, studentId, attemptNo])
  @@index([studentId, status])
  @@index([status, deadlineAt]) // sweeper for auto-submit
}

model AttemptAnswer {
  id                String    @id @default(uuid()) @db.Uuid
  attemptId         String    @db.Uuid
  questionId        String    @db.Uuid
  selectedOptionIds String[]  @db.Uuid
  numericValue      Decimal?  @db.Decimal(18, 6)
  markedForReview   Boolean   @default(false)
  timeSpentSeconds  Int       @default(0)
  answeredAt        DateTime?
  isCorrect         Boolean? // set only at evaluation
  marksAwarded      Decimal?  @db.Decimal(6, 2)
  updatedAt         DateTime  @updatedAt

  attempt  TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model TestResult {
  id               String   @id @default(uuid()) @db.Uuid
  attemptId        String   @unique @db.Uuid
  testId           String   @db.Uuid
  studentId        String   @db.Uuid
  score            Decimal  @db.Decimal(8, 2)
  correctCount     Int
  incorrectCount   Int
  unattemptedCount Int
  accuracy         Decimal  @db.Decimal(5, 2)
  rank             Int?
  percentile       Decimal? @db.Decimal(5, 2)
  sectionBreakdown Json?
  createdAt        DateTime @default(now())

  attempt TestAttempt    @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  test    Test           @relation(fields: [testId], references: [id], onDelete: Restrict)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([testId, score(sort: Desc)]) // leaderboard
  @@index([studentId, createdAt(sort: Desc)])
}

// ──────────────────── Commerce ────────────────────

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  studentId         String        @db.Uuid
  courseId          String        @db.Uuid
  batchId           String?       @db.Uuid
  couponId          String?       @db.Uuid
  receipt           String        @unique
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  currency          String        @default("INR")
  listPriceInPaise  Int
  discountInPaise   Int           @default(0)
  taxInPaise        Int           @default(0)
  amountInPaise     Int // what the gateway actually charges, calculated server-side
  status            PaymentStatus @default(CREATED)
  method            String?
  failureReason     String?
  capturedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  student    StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course     Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batch      Batch?            @relation(fields: [batchId], references: [id], onDelete: SetNull)
  coupon     Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  enrollment Enrollment?
  refunds    Refund[]
  invoice    Invoice?
  redemption CouponRedemption?

  @@index([studentId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([courseId])
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  paymentId        String       @db.Uuid
  requestedById    String       @db.Uuid
  reviewedById     String?      @db.Uuid
  razorpayRefundId String?      @unique
  amountInPaise    Int
  reason           String
  status           RefundStatus @default(REQUESTED)
  reviewNote       String?
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedBy User    @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy  User?   @relation("RefundReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([status, createdAt])
}

model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  paymentId     String   @unique @db.Uuid
  invoiceNumber String   @unique
  issuedAt      DateTime @default(now())
  billingName   String
  billingState  String?
  gstin         String?
  taxBreakdown  Json?
  storageKey    String? // private PDF in object storage
  createdAt     DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
}

model Coupon {
  id                 String       @id @default(uuid()) @db.Uuid
  code               String       @unique // stored uppercase
  description        String?
  discountType       DiscountType
  discountValue      Int // percent (1-100) or paise
  maxDiscountInPaise Int?
  minOrderInPaise    Int          @default(0)
  validFrom          DateTime
  validUntil         DateTime
  usageLimit         Int?
  perStudentLimit    Int          @default(1)
  usedCount          Int          @default(0)
  courseId           String?      @db.Uuid // null = any course
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  course      Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  payments    Payment[]
  redemptions CouponRedemption[]

  @@index([isActive, validUntil])
}

model CouponRedemption {
  id        String   @id @default(uuid()) @db.Uuid
  couponId  String   @db.Uuid
  studentId String   @db.Uuid
  paymentId String   @unique @db.Uuid
  createdAt DateTime @default(now())

  coupon  Coupon         @relation(fields: [couponId], references: [id], onDelete: Restrict)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  payment Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([couponId, studentId])
}

/// Idempotency + audit trail for gateway / video / live-provider webhooks.
model WebhookEvent {
  id          String        @id @default(uuid()) @db.Uuid
  provider    String // razorpay | mux | livekit
  eventId     String // provider's event id
  eventType   String
  payload     Json
  status      WebhookStatus @default(RECEIVED)
  attempts    Int           @default(0)
  error       String?
  receivedAt  DateTime      @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([status, receivedAt])
}

// ─────────────── Community, notifications, offline ───────────────

model Doubt {
  id                String      @id @default(uuid()) @db.Uuid
  studentId         String      @db.Uuid
  courseId          String?     @db.Uuid
  lessonId          String?     @db.Uuid
  assignedTeacherId String?     @db.Uuid
  subject           String
  title             String
  body              String
  imageUrls         String[]
  status            DoubtStatus @default(OPEN)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  student         StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course          Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lesson          Lesson?         @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  assignedTeacher TeacherProfile? @relation(fields: [assignedTeacherId], references: [id], onDelete: SetNull)
  replies         DoubtReply[]

  @@index([studentId, createdAt(sort: Desc)])
  @@index([assignedTeacherId, status])
  @@index([status, createdAt])
}

model DoubtReply {
  id         String   @id @default(uuid()) @db.Uuid
  doubtId    String   @db.Uuid
  authorId   String   @db.Uuid
  body       String
  imageUrls  String[]
  isAccepted Boolean  @default(false)
  createdAt  DateTime @default(now())

  doubt  Doubt @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([doubtId, createdAt])
}

model Review {
  id        String           @id @default(uuid()) @db.Uuid
  courseId  String           @db.Uuid
  studentId String           @db.Uuid
  rating    Int // 1..5 (CHECK in constraints.sql)
  comment   String?
  status    ModerationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([courseId, status])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  pushedAt  DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
}

model Announcement {
  id          String               @id @default(uuid()) @db.Uuid
  authorId    String               @db.Uuid
  courseId    String?              @db.Uuid
  audience    AnnouncementAudience @default(ALL)
  title       String
  body        String
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  author User    @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([audience, publishedAt(sort: Desc)])
  @@index([courseId])
}

model LearningCentre {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  slug         String       @unique
  description  String?
  addressLine  String
  city         String
  state        String
  pincode      String
  latitude     Decimal      @db.Decimal(9, 6)
  longitude    Decimal      @db.Decimal(9, 6)
  phone        String?
  email        String?
  openingHours Json?
  facilities   String[]
  photoUrls    String[]
  ratingAvg    Decimal      @default(0) @db.Decimal(3, 2)
  ratingCount  Int          @default(0)
  status       CentreStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  batches  Batch[]
  reviews  CentreReview[]
  bookings CounsellingBooking[]

  @@index([city, status])
  @@index([latitude, longitude]) // bounding-box prefilter; move to PostGIS if volume demands
}

model CentreReview {
  id        String           @id @default(uuid()) @db.Uuid
  centreId  String           @db.Uuid
  studentId String           @db.Uuid
  rating    Int
  comment   String?
  status    ModerationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  centre  LearningCentre @relation(fields: [centreId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([centreId, studentId])
  @@index([centreId, status])
}

model CounsellingBooking {
  id              String        @id @default(uuid()) @db.Uuid
  centreId        String        @db.Uuid
  studentId       String        @db.Uuid
  courseId        String?       @db.Uuid
  scheduledAt     DateTime
  durationMinutes Int           @default(30)
  status          BookingStatus @default(REQUESTED)
  topic           String?
  notes           String?
  cancelReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  centre  LearningCentre @relation(fields: [centreId], references: [id], onDelete: Restrict)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course  Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([centreId, studentId, scheduledAt])
  @@index([centreId, scheduledAt])
  @@index([studentId, status])
}

// ──────────────────── Support and audit ────────────────────

model SupportTicket {
  id           String         @id @default(uuid()) @db.Uuid
  ticketNumber Int            @unique @default(autoincrement())
  requesterId  String         @db.Uuid
  assigneeId   String?        @db.Uuid
  category     String
  subject      String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(NORMAL)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  closedAt     DateTime?

  requester User            @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee  User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages  TicketMessage[]

  @@index([requesterId, status])
  @@index([assigneeId, status])
  @@index([status, priority, createdAt])
}

model TicketMessage {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @db.Uuid
  authorId    String   @db.Uuid
  body        String
  attachments String[]
  isInternal  Boolean  @default(false) // staff-only note
  createdAt   DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

/// Append-only. constraints.sql installs a trigger that rejects UPDATE/DELETE.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String // e.g. refund.approved
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt])
}
